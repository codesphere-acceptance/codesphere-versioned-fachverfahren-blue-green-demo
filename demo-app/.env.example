# Copy to .env.local for local development.
#
# On Codesphere these are not used: start-app.sh assembles DATABASE_URL from the
# POSTGRES_* variables declared in ci.dev.yml / ci.qa.yml, and APP_BASE_URL comes
# from a Codesphere runtime template.
#
# The port matches infrastructure/dev/docker-compose.yml.
DATABASE_URL=postgresql://demo_app:demo_app@localhost:5433/demo_app
APP_BASE_URL=http://localhost:3000
