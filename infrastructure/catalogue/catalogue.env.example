# Catalogue (managed-services) credentials for provider.sh and the catalogue
# pipeline. Copy to catalogue.env and fill in. Never commit catalogue.env — it
# holds a live API token (it is gitignored).

# Codesphere API token of the publishing (technical) user. This user's Git
# connection is used to pull the landscape repo, so it must have access to it.
# Codesphere > Account Settings > API Keys.
CS_TOKEN=

# Codesphere API base URL (no trailing slash). Defaults to the public cloud.
CS_API=https://cloud.codesphere.com/api

# Org scope: comma-separated team ids the provider is
# scoped to. Scope is applied at publish time, NOT in provider.yml. Leave the
# 'team' scope below to restrict to these teams (tenant separation); publishing
# 'global' requires cluster-admin rights and is out of scope for this demo.
CS_TEAM_IDS=

# Team id used for read-only visibility checks (list). For the cross-tenant
# cross-tenant check, point this at a DIFFERENT team that is NOT in CS_TEAM_IDS
# and confirm the provider does not appear.
CS_QUERY_TEAM_ID=

# The landscape/provider repository and the ref to publish from. gitRef should
# match a version's gitRef in provider.yml (a release tag) for a reproducible
# publish; defaults to the repo's default branch when empty.
GIT_URL=https://github.com/codesphere-acceptance/codesphere-versioned-fachverfahren-blue-green-demo
GIT_REF=

# Path to the provider file within the repo (defaults to provider.yml at root).
PROVIDER_FILE=provider.yml

# How `publish` sends the definition:
#   git  (default) Codesphere fetches provider.yml from GIT_URL@GIT_REF. Needs
#                  the repo reachable (public, or the token user's Git
#                  connection). This is the default CI/CD pipeline path.
#   spec           Send the full definition inline from the local provider.yml.
#                  No repo fetch needed — handy for local trials.
PUBLISH_METHOD=git
